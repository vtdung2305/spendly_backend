# .env.example — copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# Database (matches the "db" service in docker-compose.yml)
DATABASE_URL=postgresql://spendly:spendly@db:5432/spendly_dev?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=replace-with-min-32-char-secret-devonly
JWT_REFRESH_SECRET=replace-with-min-32-char-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email OTP (register verification)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# OAuth
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret

# MinIO (S3-compatible object storage for avatars)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=spendly
MINIO_SECRET_KEY=spendly12345
MINIO_BUCKET=spendly-avatars
# Public base URL the API rewrites into avatar URLs returned to clients.
# In docker-compose this is the host-mapped MinIO port so the mobile app can load images directly.
MINIO_PUBLIC_URL=http://localhost:9000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Upload limits
MAX_AVATAR_SIZE=5242880

# Mail (SMTP) — password reset emails are sent async via the "emails" BullMQ queue.
# For local dev, use https://ethereal.email (free disposable inbox) or Mailtrap.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=Spendly <no-reply@spendly.app>
# Frontend route the reset link points to; app deep-link handles ?token=...
APP_RESET_PASSWORD_URL=http://localhost:8081/reset-password
